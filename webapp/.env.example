# Copy this file to .env and fill in what you have. Everything is optional for a local demo:
# without SMTP/Twilio settings, messages are recorded on the admin Notifications page instead of being sent.

SECRET_KEY=change-this-to-a-long-random-string
# Used in the links inside emails/SMS. Put your https tunnel address here when you demo on phones.
PUBLIC_BASE_URL=http://localhost:5000

# First authority login, created the first time the app starts.
# Change it later from Account > Change your password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Models from the Kaggle notebook (unzip pothole_models.zip into webapp/models/). Paths are relative to webapp/.
DETECTOR_WEIGHTS=models/pothole_detector.pt
# To detect all 4 damage classes instead, use the 4-class model:
# DETECTOR_WEIGHTS=models/road_damage_4class.pt
VERIFIER_WEIGHTS=models/pothole_verifier.pt
DEPLOY_CONFIG=models/deploy_config.json
# Override the thresholds tuned by the notebook:
# DET_CONF=0.30
# VERIFIER_THRESHOLD=0.5

# GPS alerts: warn drivers about potholes within this many metres
ALERT_RADIUS_M=1000
# Reports closer than this to an open report are merged into it
DUPLICATE_RADIUS_M=15

# Raspberry Pi pothole box: put the same token in device/config.yaml (device_token). Empty = device API off.
DEVICE_TOKEN=
# After a pothole is marked fixed, this many separate passes by boxes that still find it reopen the complaint
REOPEN_AFTER_PASSES=2
# Passes closer together than this count as one pass (use 10 for a classroom demo)
REPASS_SECONDS=60

# Email through Gmail: turn on 2-Step Verification, then create an App Password
# (Google Account > Security > 2-Step Verification > App passwords) and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS through Twilio. A trial account can only text numbers you have verified in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DEFAULT_COUNTRY_CODE=+91

# OpenStreetMap asks for a contact in the User-Agent
NOMINATIM_USER_AGENT=PotholeWatch/1.0 (your-email@example.com)
REVERSE_GEOCODE=true

DEVICE_TOKEN=guddu-box-secret-2026
REOPEN_AFTER_PASSES=2
REPASS_SECONDS=10
